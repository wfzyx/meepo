{
  "name": "@wfzyx/meepo",
  "version": "0.1.0",
  "description": "Multi-brain local/hybrid agent orchestration for Pi: Divided We Stand",
  "license": "Apache-2.0",
  "author": "wfzyx",
  "type": "module",
  "bin": {
    "meepo": "./bin/meepo"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "meepo.config.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "coding-agent",
    "llama-server",
    "llm-router"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "bun build src/index.ts --outfile dist/index.js --target node --external @earendil-works/* --external typebox && tsc --emitDeclarationOnly --outDir dist",
    "prepublishOnly": "bun run build && bun test",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "benchmark": "bun run src/benchmark/cli.ts",
    "benchmark:workflow": "bun run src/benchmark/cli.ts --workflow",
    "start": "bun run src/cli.ts serve",
    "compile": "bun build --compile --outfile bin/meepo src/cli.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "latest"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "bun-types": "^1.4.2",
    "typescript": "^5.6.0"
  }
}
