{
  "name": "@wfzyx/meepo",
  "version": "0.1.0",
  "description": "Multi-brain local/hybrid agent orchestration for Pi: Divided We Stand",
  "license": "Apache-2.0",
  "author": "wfzyx",
  "type": "module",
  "bin": {
    "meepo": "./bin/meepo"
  },
  "files": [
    "bin",
    "extension/dist",
    "extension/package.json",
    "extension/README.md",
    "core/meepo.config.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "coding-agent",
    "llama-server",
    "llm-router"
  ],
  "pi": {
    "extensions": [
      "./extension/dist/index.js"
    ]
  },
  "scripts": {
    "build:go": "(cd core && go build -ldflags=\"-s -w\" -o ../bin/meepo ./cmd/meepo)",
    "build:extension": "cd extension && bun run build",
    "build": "bun run build:extension && bun run build:go",
    "test": "(cd extension && bun test) && (cd core && go test ./...)",
    "start": "./bin/meepo serve"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "bun-types": "^1.4.2",
    "typescript": "^5.6.0"
  }
}
